{% comment %}
  Shows a "Coming soon" label when the product has a "wip" tag.
  Renders as an overlay on media, or as inline text when `inline` is true.

  Accepts:
  - product: {Object} Product Liquid object
  - inline: {Boolean} Render as text instead of a full overlay. Default: false
{% endcomment %}

{%- liquid
  assign is_wip = false
  if product != blank
    for tag in product.tags
      assign downcased_tag = tag | downcase
      if downcased_tag == 'wip'
        assign is_wip = true
        break
      endif
    endfor
  endif
-%}

{%- if is_wip -%}
  <div class="coming-soon-overlay{% if inline %} coming-soon-overlay--inline{% endif %}">
    <span class="coming-soon-overlay__label">{{ 'products.product.coming_soon' | t }}</span>
  </div>
{%- endif -%}
