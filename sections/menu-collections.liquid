{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'section-menu-collections.css' | asset_url | stylesheet_tag }}
{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'coming-soon-overlay.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0
  assign max_columns_to_show = columns_mobile_int
  if columns_desktop_int > columns_mobile_int
    assign max_columns_to_show = columns_desktop_int
  endif

  assign use_selected_collections = false
  for block in section.blocks
    if block.settings.collection != blank
      assign use_selected_collections = true
      break
    endif
  endfor

  assign menu_handles = ''
  if use_selected_collections
    for block in section.blocks
      if block.settings.collection != blank and block.settings.collection.handle != 'all'
        assign menu_handles = menu_handles | append: block.settings.collection.handle | append: ','
      endif
    endfor
  else
    for collection in collections
      unless collection.handle == 'all' or collection.all_products_count == 0
        assign menu_handles = menu_handles | append: collection.handle | append: ','
      endunless
    endfor
  endif

  assign menu_handles = menu_handles | split: ','
-%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div
    class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="menu-collections__intro title-wrapper title-wrapper--no-top-margin page-width">
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="collection__description {{ section.settings.description_style }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign card_index = 0 -%}
    {%- for handle in menu_handles -%}
      {%- if handle == blank -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign menu_collection = collections[handle] -%}
      {%- if menu_collection == blank or menu_collection.handle == 'all' or menu_collection.products.size == 0 -%}
        {%- continue -%}
      {%- endif -%}

      <div
        class="menu-collection page-width"
        id="MenuCollection-{{ section.id }}-{{ menu_collection.handle }}"
      >
        <div class="menu-collection__header collection__title title-wrapper title-wrapper--no-top-margin">
          <h3 class="menu-collection__title title inline-richtext {{ section.settings.collection_heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ menu_collection.title | escape }}
          </h3>
          {%- if menu_collection.description != blank -%}
            <div class="menu-collection__description collection__description {{ section.settings.description_style }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
              {{ menu_collection.description }}
            </div>
          {%- endif -%}
        </div>

        <ul
          class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          role="list"
        >
          {%- for product in menu_collection.products limit: section.settings.products_to_show -%}
            {%- assign card_index = card_index | plus: 1 -%}
            {%- assign lazy_load = false -%}
            {%- if card_index > max_columns_to_show -%}
              {%- assign lazy_load = true -%}
            {%- endif -%}
            <li
              class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ card_index }};"
              {% endif %}
            >
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                lazy_load: lazy_load,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                show_description: true,
                skip_styles: true,
                section_id: section.id,
                quick_add: 'none',
                product_view_context: 'collection'
              %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}

    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Menu collections",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows each collection as its own group, using the collection title and description from admin. The All collection is never shown. Add collection blocks below to choose and order specific collections; otherwise every other collection is listed automatically."
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_text.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Menu",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
